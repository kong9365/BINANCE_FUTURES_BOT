# =====================================================================
# Binance Futures Bot — .env 템플릿
# 이 파일을 .env 로 복사한 뒤 실제 값으로 채운다 (cp .env.example .env).
# .env 는 .gitignore 로 커밋 금지 — 실제 키는 절대 저장소에 올리지 말 것.
# =====================================================================

# ── 실거래 키 (USE_TESTNET=false 일 때 사용) ──
# Futures only 권한, 출금/Universal Transfer 비활성 권장
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── 테스트넷 키 (USE_TESTNET=true 일 때 사용) ──
# testnet.binancefuture.com 전용 키 (live 키로 폴백하지 않음 — 슬롯 분리 필수)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# true → 테스트넷/페이퍼(data/bot.db), false → 실거래(data/bot_live.db)
USE_TESTNET=true

# ── 보호 종목 (봇이 절대 거래하지 않음). 비우면 코드 기본값 사용 ──
# 기본값: BTCUSDT,ETHUSDT,HOLOUSDT,CFXUSDT,LYNUSDT
PROTECTED_SYMBOLS=BTCUSDT,ETHUSDT,HOLOUSDT,CFXUSDT,LYNUSDT

# ── 분석/알림 (선택) ──
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CMC_API_KEY=

# ── 운영 옵션 (선택) ──
LOG_LEVEL=INFO
HEARTBEAT_INTERVAL_S=3600
OPERATOR_ID=
ENVIRONMENT=development
# DB_PATH=          # 지정 시 USE_TESTNET 기본 경로보다 우선 (보통 비워둠)
